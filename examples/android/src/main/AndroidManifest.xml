<?xml version="1.0" encoding="utf-8"?>
<!--
  GameActivity 版本的 manifest。

  与旧 `manifest.yaml`（xbuild）的三点差异，都是必须改的：

  1. activity 是 Java 类 `MainActivity`（`extends GameActivity`）而不是
     `android.app.lib_name` meta-data。GameActivity 是 gradle AAR 里的类，
     manifest 只能这么声明。
  2. theme 必须是 AppCompat 子主题（GameActivity 继承 AppCompatActivity）。
  3. **不要**加 `android.app.lib_name` / `android_native_app_glue`：
     android-activity 的构建脚本已把同名 .so 动态打进 cdylib，
     否则会装进两套胶水层反而出问题。加载由 Java 侧 `System.loadLibrary` 负责。

  enableOnBackInvokedCallback="true"（API 33+ 才认）—— **不加它返回键完全收不到**：
  targetSdk >= 33 时系统默认**不**把返回键路由给 OnBackInvokedDispatcher，
  于是 `registerOnBackInvokedCallback` 注册了也不会被触发；同时
  `Activity.onBackPressed()` 覆写在 33+ 被系统直接忽略。两者叠加的结果是
  「注册成功但按返回键毫无反应」（真机实测踩过，logcat 里 dispatcher 的
  注册日志有、回调日志没有）。

  加了它之后 `onBackPressed()` 覆写在 33+ **彻底失效**（这是有意的），
  所以 MainActivity.java 里的 API 分档才是必需的：33+ 只靠 dispatcher，
  31/32 只靠 onBackPressed 覆写。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="Vireo Android"
        android:theme="@style/ActivityTheme"
        android:hardwareAccelerated="true"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>